{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm.cmd install",
      "problemMatcher": []
    },
    {
      "label": "Init PostgreSQL database",
      "type": "shell",
      "command": "npm.cmd run db:init",
      "problemMatcher": []
    },
    {
      "label": "Migrate PostgreSQL database",
      "type": "shell",
      "command": "npm.cmd run db:migrate",
      "problemMatcher": []
    },
    {
      "label": "Start PostgreSQL with Docker",
      "type": "shell",
      "command": ".\\scripts\\start-postgres.cmd",
      "problemMatcher": []
    },
    {
      "label": "Start project",
      "type": "shell",
      "command": ".\\scripts\\start-project.cmd",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Stop project",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\stop-project.ps1",
      "problemMatcher": []
    },
    {
      "label": "Run full stack app",
      "type": "shell",
      "command": "npm.cmd run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npm.cmd run typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm.cmd run build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Test API workflow",
      "type": "shell",
      "command": "npm.cmd run test",
      "problemMatcher": []
    },
    {
      "label": "Test E2E browser workflow",
      "type": "shell",
      "command": "npm.cmd run test:e2e",
      "problemMatcher": []
    },
    {
      "label": "Test API performance",
      "type": "shell",
      "command": "npm.cmd run test:perf",
      "problemMatcher": []
    },
    {
      "label": "Pre-push check",
      "type": "shell",
      "command": "npm.cmd run typecheck; if ($LASTEXITCODE -eq 0) { npm.cmd run build }; if ($LASTEXITCODE -eq 0) { npm.cmd run test }; if ($LASTEXITCODE -eq 0) { npm.cmd run test:e2e }",
      "problemMatcher": []
    }
  ]
}
