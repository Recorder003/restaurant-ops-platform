# Local development defaults. Copy this file to `.env` for local runs.
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant_orders
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Replace this with a long random value before any production deployment.
AUTH_TOKEN_SECRET=change-this-long-random-secret-before-production

# Optional. Enables the admin AI daily summary; without this key the app uses a rules-based fallback summary.
OPENAI_API_KEY=
AI_SUMMARY_MODEL=gpt-4o-mini
